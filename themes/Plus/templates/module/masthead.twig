<div id="masthead-container">
   <div class="logo-container valign-container">
      <a class="logo sprite valign" href="/" title="SubRocks+ home"></a>
   </div>
   {%- if app.core.loggedIn -%}
   <div id="masthead-user-container" class="valign-container">
      <span id="masthead-display-name" onclick=";_gel('masthead-user').click();" class="display-name">
         {{ app.core.username }}
      </span>
      <button id="sb-button-notify" onclick=";return false;" type="button" role="button" class="sb-notif-off uix-button uix-button-masthead yt-uix-button-size-default"><span class="uix-button-content">0</span></button>
      <button id="sb-button-share" onclick=";return false;" type="button" role="button" class="sb-notif-off uix-button uix-button-masthead yt-uix-button-size-default"><span class="icon"></span><span class="uix-button-content">Share</span><span class="arrow"></span></button>
      <span id="masthead-user" class="uix-clickcard">
         <span id="masthead-user-avatar-container" class="valign-container uix-clickcard-target">
            <img id="masthead-user-avatar" src="//{{ app.consts.DYNAMIC_HOST }}/dynamic/pfp/{{ app.core.useravatar }}">
         </span>
         <span class="arrow"></span>
         <div class="masthead-user-clickcard uix-clickcard-content">
            <div class="uix-clickcard-arrow">
               <span class="outer"><span class="inner"></span>
            </div>
            <div class="primary">
               <div class="user-info">
                  <div class="username">
                     {{ app.core.username }}
                  </div>
                  <div class="email">
                     {{ app.core.useremail }}
                  </div>
                  <div class="settings-button">
                     <a href="//{{app.consts.SUBROCKS_HOST}}/user/{{app.core.username}}" class="uix-button uix-button-primary">SubRocks Account</a>
                  </div>
               </div>
            </div>
            <div class="secondary">
               <a href="/signout" class="signout-button uix-button uix-button-default">Sign out</a>
            </div>
         </div>
      </span>
   </div>
   {% else %}
   <div id="masthead-signin-container" class="valign-container">
      <a id="masthead-signin" class="valign uix-button uix-button-red" href="/signin"><span class="uix-button-content">Sign in</span></a>
   </div>
   {% endif %}
   <div id="masthead-content" class="">
      <form id="masthead-search" class="search-form consolidated-form valign-container" action="/results" onsubmit="if (_gel('masthead-search-term').value == '') return false;">
         <div id="masthead-search-terms" class="masthead-search-terms-border " dir="ltr"><label><input id="masthead-search-term" class="search-term uix-form-input-bidi" name="search_query" value="" type="text" tabindex="1" title="Search" dir="ltr" autocomplete="off" spellcheck="false" style="outline: currentcolor none medium;"></label></div>
         <button dir="ltr" tabindex="2" class="search-btn-component search-button" onclick="if (_gel('masthead-search-term').value == '') return false; _gel('masthead-search').submit(); return false;;return true;" type="submit" id="search-btn" role="button"><span class="uix-button-content"></span></button>
         <input type="hidden" name="oq"><input type="hidden" name="gs_l">
      </form>
   </div>
</div>