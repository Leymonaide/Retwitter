{% extends app.spfnavigate ? 'base_spf.twig' : 'base.twig' %}

{% set guideSelectedItem = 'profile' %}

{% block title %}{{ parent() }}{% endblock %}

{%- block page_header -%}
   <{{"style"}} id="user-style-{{ app.page.profile.id }}">
      #profile-banner, #guide-item-profile .image-arrow
      {
         background: url({{ app.page.profile.bannerUrl }});
         background-size: {{ 970 + 12 }}px auto;
      }
      
      #profile-banner
      {
         height: 180px;
         background-position: -12px 0;
      }
      
      #guide-item-profile .image-arrow
      {
         background-position: 0 -36px;
      }
   </{{"style"}}>
   <div id="profile-info">
      <div id="profile-info-card">
         <div class="profile-picture">
            <img src="{{ app.page.profile.avatarUrl }}" title="{{ app.page.profile.title }}">
         </div>
      </div>
      <div id="profile-info-secondary-card">
         {% set snippets_html %}
         {% if app.page.profile.birthdayText %}
            <div class="birthday info-snippet">
               <span class="icon"></span>
               <div class="info">Born on <b>{{ app.page.profile.birthdayText }}</b></div>
            </div>
         {% endif %}
         {% if app.page.profile.websiteUrl %}
            <div class="website-url info-snippet">
               <span class="icon"></span>
               <div class="info"><a href="{{ app.page.profile.websiteUrl }}">{{ app.page.profile.websiteUrl }}</a></div>
            </div>
         {% endif %}
         {% endset %}
         {# Hack to put a "last" class on the last item. #}
         {% set snippets_html = snippets_html|split("info-snippet") %}
         {% for snippet in snippets_html %}
            {% if loop.last %}{#
               #}info-snippet last{{ snippet|raw }}{#
            #}{% elseif loop.first %}{#
               #}{{ snippet|raw }}{#
            #}{% else %}{#
               #}info-snippet{{ snippet|raw }}{#
            #}{% endif %}
         {% endfor %}
      </div>
   </div>
   <div id="header-container">
      <div class="header">
         <span class="title">{{ app.page.profile.title }}</span>
         <span class="feed-controls profile-actions valign clearfix">
            <button class="uix-button uix-button-primary">Edit profile</button>
         </span>
      </div>
   </div>
   <div id="profile-banner"></div>
{% endblock %}

{%- block content -%}
<div class="profile-tabs valign uix-button-group">
   <button class="uix-button uix-button-light start uix-button-active">Posts</button>{#
   #}<button class="uix-button uix-button-light ">About</button>{#
   #}<button class="uix-button uix-button-light ">Media</button>{#
   #}<button class="uix-button uix-button-light end">+1's</button>
</div>
<ul class="feed">
   {% for post in app.page.feed.posts %}
      <li class="feed-item">
         {% import "/module/feed.twig" as feed %}
         {{ feed.render_feed_post(post) }}
      </li>
   {% endfor %}
</ul>
{% endblock %}