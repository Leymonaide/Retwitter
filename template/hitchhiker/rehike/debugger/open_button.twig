{# 
    Implements the Rehike debugger popup button.
#}

{% with { rebugbtn: rehikeDebugger.openButton } %}
<div id="rebug-open-button-container">
    <button id="rebug-open-button" class="rebug-open-button {{ rebugbtn.class|join(' ') }}">
        <span>{{ rebugbtn.text }}</span>
    </button>
</div>
{% endwith %}