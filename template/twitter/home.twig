{% extends "core/core.twig" %}

{% set retwitter_g_js_page_name = "home" %}
{% set retwitter_g_js_page_context = null %}
{% set retwitter_g_boot_module = "app/pages/home" %}
{% set retwitter_g_page_section = "home" %}

{% import "core/macros.twig" as core %}

{% block body_class %}
{{ parent() }}
enhanced-mini-profile
no-nav-banners
supports-drag-and-drop
profile-field-editing
{% endblock %}

{% block page_class %}
wrapper
wrapper-home
{% endblock %}

{% block content %}
    {% import "common/timeline.twig" as timeline %}
    <div class="dashboard dashboard-left">
        {% for module in app.page.dashboard.leftModules %}
            {{ _self.dashboard_render_module(module) }}
        {% endfor %}
    </div>
    {{ timeline.render_timeline(app.page.timeline, {
        timelineClasses: [
            "content-main",
            "top-timeline-tweetbox",
        ]
    }) }}
    <div class="dashboard dashboard-right">
        
    </div>
{% endblock %}

{% macro dashboard_render_module(module) %}
    {% if module.getModuleType() == "ProfileCard" %}
        {{ _self.dashboard_render_profile_card_module(module) }}
    {% endif %}
{% endmacro %}

{% macro dashboard_render_profile_card_module(module) %}
    {% set m = "DashboardProfileCard" %}
    <div class="{{ m }} module">
        <a class="{{ m }}-bg u-bgUserColor u-block"
           href="/{{ module.username }}"
           tabindex="-1"
           aria-hidden="true"
           rel="noopener"
           {% if module.bannerUrl %} {# This is probably not how it was actually done, but this is easy. #}
                style="background-image: url({{ module.bannerUrl }})"
           {% endif %}></a>
        <div class="{{ m }}-content">
            <div class="{{ m }}-avatarContainer">
                <div id="choose-photo" class="{{ [
                        "controls",
                        "avatar-settings",
                        "inline-upload-avatar",
                        "dropdown",
                        "center",
                     ]|join(" ") }}">
                    <a class="{{ [
                            m~"-avatarLink",
                            "ProfileAvatar-placeholder",
                            "u-inlineBlock",
                            "js-nav",
                            "js-tooltip",
                            "profile-picture",
                            "js-dropdown-toggle",
                       ]|join(" ") }}"
                       href="/{{ module.username }}"
                       tabindex="-1"
                       aria-hidden="true"
                       data-placement="top"
                       data-scribe-element="profile_avatar"
                       role="button"
                       aria-haspopup="true"
                       title="Add a profile photo">
                        <div class="{{ [
                                m~"-avatarImage",
                                "u-borderUserColorLightHover",
                                "u-bgUserColor",
                                "u-hidden",
                             ]|join(" ") }}"
                             data-avatar-placeholder="true"></div>
                        <img class="{{ [
                                m~"-avatarImage",
                                "u-borderUserColorLightHover",
                                "js-action-profile-avatar",
                             ]|join(" ") }}"
                             src="{{ module.avatarUrl }}">
                    </a>
                    <div class="uploader-image uploader-avatar clearfix">
                        {# TODO(kawapure): <div class="dropdown-menu">
                        <div class="dropdown-caret"></div>
                        <ul>
                            <li id="photo-choose-existing" class="photo-choose-existing upload-photo">
                            <button type="button" class="dropdown-link">Upload photo</button>
                            <div class="photo-selector">
                                <button class="btn" type="button">Change photo</button> <span class="photo-file-name">No file selected</span>
                                <div class="image-selector">
                                <input type="hidden" name="media_file_name" class="file-name"> <input type="hidden" name="media_data_empty" class="file-data"> <label class="t1-label"><span class="u-hiddenVisually">Add Photo</span> <input type="file" name="media[]" class="file-input" tabindex="-1" title="Add Photo" accept="image/gif,image/jpeg,image/jpg,image/png"></label>
                                </div>
                            </div>
                            </li>
                            <li id="photo-choose-webcam" class="u-hidden"><button type="button" class="dropdown-link">Take photo</button></li>
                            <li id="photo-delete-image" class="u-hidden"><button type="button" class="dropdown-link">Remove</button></li>
                            <li class="cancel-options"><button type="button" class="dropdown-link">Cancel</button></li>
                        </ul>
                        </div>#}
                    </div>
                </div>
            </div>
            <div class="{{ m }}-userFields account-group">
                <div class="{{ m }}-name u-textTruncate">
                    <a class="u-textInheritColor js-nav"
                       href="/{{ module.username }}">{{ 
                        core.text(module.displayName) 
                    }}</a>
                </div>
                <div class="{{ m }}-screenname u-inlineBlock u-dir" dir="ltr">
                    <a class="{{ [
                            m~"-screennameLink",
                            "u-linkComplex",
                            "u-linkClean",
                            "js-nav"
                       ]|join(" ") }}"
                       href="/{{ module.username }}"
                       rel="noopener">
                        <span class="username u-dir" dir="ltr">
                            @<b class="u-linkComplex-target">{{ module.username }}</b>
                        </span>
                    </a>
                </div>
            </div>
            {{ _self.dashboard_render_profile_card_stats(module.stats) }}
            <div id="dashboard-profile-prompt"></div>
        </div>
    </div>
{% endmacro %}

{% macro dashboard_render_profile_card_stats(stats) %}
    {% set m = "ProfileCardStats" %}
    <div class="{{ m }}">
        <ul class="{{ [
                m~"-statList",
                "Arrange",
                "Arrange--bottom",
                "Arrange--equal",
            ]|join(" ") }}">
            {% for stat in stats %}
                <li class="{{ m }}-stat Arrange-sizeFit">
                    <a class="{{ [
                            m~"-statLink",
                            "u-textUserColor",
                            "u-linkClean",
                            "u-block",
                            "js-nav",
                            "js-tooltip",
                    ]|join(" ") }}"
                    href="{{ stat.url }}"
                    data-element-term="{{ stat.id }}"
                    title="{{ stat.tooltip }}">
                        <span class="{{ m }}-statLabel u-block">{{ stat.label }}</span>
                        <span class="{{ m }}-statValue"
                            data-count="{{ stat.count }}"
                            data-is-compact="false{# TODO #}">{{ stat.value }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endmacro %}