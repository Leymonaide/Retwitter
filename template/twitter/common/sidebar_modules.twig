{% import "core/macros.twig" as core %}
{% from "common/edge_button.twig" import render as edge_button %}
{% from "common/pageframe/footer.twig" import render as footer %}
<div class="SidebarCommonModules">
    {% if not app.isLoggedIn() %}
    <div class="SignupCallOut module js-signup-call-out">
        <div class="SignupCallOut-header">
            <h3 class="SignupCallOut-title u-textBreak">
                {{ app.i18n.get("common", "signup_callout_header") }}
            </h3>
        </div>
        <div class="SignupCallOut-subheader">
            {{ app.i18n.get("common", "signup_callout_message") }}
        </div>
        <div class="signup SignupForm">
            {% set ButtonStyle = enum("Retwitter\\Page\\Common\\ButtonStyle") %}
            {% set ButtonSize  = enum("Retwitter\\Page\\Common\\ButtonSize") %}
            {{ edge_button(
                data: {
                    url: "/signup",
                    style: ButtonStyle.Primary,
                    size: ButtonSize.Large,
                    label: app.i18n.get("common", "signup_callout_action")
                },
                classes: [ "SignupForm-submit", "u-block", "js-signup" ],
                attributes: {
                    component: "signup_callout",
                    element: "form"
                }
            ) }}
        </div>
    </div>
    {% endif %}
    {# TODO(aubymori): Trends #}
    {{ footer(app.page.footer, {
        slim: true,
        blankBackground: true
    }) }}
</div>

{# Who to follow module. I think this is unique to the home page. #}
{% macro render_who_to_follow_module(module) %}
    {% types {
        module: "Retwitter\\Page\\Home\\Dashboard\\MWhoToFollowModule",
    } %}
    {% import "common/user_small_list.twig" as user_small_list %}
    <div class="{{ [
            'module',
            'wtf-module',
            'js-wtf-module',
            'roaming-module',
            'has-content',
        ]|join(' ') }}">
        <div class="flex-module">
            <div class="flex-module-header">
                <h3>Who to follow</h3>
                <small>·</small>
                <button type="button" class="btn-link js-refresh-suggestions">
                    <small>Refresh</small>
                </button>
                <small class="view-all">
                    ·
                    <a class="js-view-all-link js-nav"
                        href="/who_to_follow/suggestions"
                        data-element-term="view_all_link">View all</a>
                </small>
            </div>
            <div class="{{ [
                    'js-recommended-followers',
                    'dashboard-user-recommendations',
                    'flex-module-inner',
                ]|join(' ') }}"
                data-section-id="wtf"
                style="opacity: 1"{# <- Probably a runtime effect. #}>
                {% for user in module.users %}
                    {{ user_small_list.render_item(user) }}
                {% endfor %}
            </div>
        </div>
    </div>
{% endmacro %}

{# Related users module used on profile pages. #}
{% macro render_related_users_module() %}
    {% import "common/user_small_list.twig" as user_small_list %}
    <div class="RelatedUsers module">
        <div class="RelatedUsers-header">
            <h3 class="RelatedUsers-title">こちらもおすすめです</h3> ·
            <button class="btn-link js-refresh-related-users" type="button">更新</button>
        </div>
        <div class="RelatedUsers-users">
            {# For each user, render user small list item. #}
        </div>
    </div>
{% endmacro %}

{% macro render_trends_module(module) %}
    {% types {
        module: "Retwitter\\Page\\Common\\Trends\\MTrendsModule",
    } %}
    <div class="module Trends trends">
        <div class="trends-inner">
            <div class="{{ [
                    'flex-module',
                    'trends-container',
                    'context-trends-container',
                ]|join(' ') }}">
                <div class="flex-module-header">
                    <h3>
                        <span class="trend-location js-trend-location">
                            Trends for you
                        </span>
                        {# This is conditional, either only on the homepage
                           or only when logged in. #}
                        {% if app.isLoggedIn() %}
                            <span class="middot" aria-hidden="true">·</span>
                            <a role="button"
                               href="#"
                               data-modal="change-trends"
                               class="{{ [
                                    'btn-link',
                                    'change-trends',
                                    'js-trend-toggle',
                               ]|join(' ') }}">
                                {# Display text: #}
                                <span aria-hidden="true">Change</span>
                                {# Accessibility text: #}
                                <span class="u-hiddenVisually">
                                    Change trend settings
                                </span>
                            </a>
                        {% endif %}
                    </h3>
                </div>
                <div class="flex-module-inner">
                    <ul class="trend-items js-trends">
                        {% for trend in module.trends %}
                            {{ _self.render_trend_item(trend) }}
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro render_trend_item(trend) %}
    {% types {
        trend: "Retwitter\\Page\\Common\\Timeline\\MTrend",
    } %}
    <li class="{{ [
            'trend-item',
            'js-trend-item',
            false ? 'promoted-trend',
            'context-trend-item',
        ]|join(' ') }}"
        data-trend-name="{{ trend.name }}"
        data-trends-id="{{ trend.id }}"
        {# The trend token here seems constant: #}
        data-trend-token=":location_request:entity_trend:taxi_country_source:">
        <a class="pretty-link js-nav js-tooltip u-linkComplex"
           href="{{ trend.url }}"
           data-query-source="trend_click"
           title="">
            <span class="u-linkComplex-target trend-name" dir="ltr">{{ 
                trend.name
            }}</span>
            <div class="js-nav trend-item-context">{{ trend.context }}</div>
            <div class="js-nav trend-item-stats">
                {{ trend.description }}
            </div>
            {% if false %}
                <span class="with-icn js-disclosure js-tooltip" title="">
                    <b class="promoted-text">Promoted by Comicstaan</b>
                </span>
            {% endif %}
        </a>
    </li>
{% endmacro %}