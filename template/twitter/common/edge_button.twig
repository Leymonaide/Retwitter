{# Class and attributes are optional arguments for special template cases. #}
{% macro render(data, classes, attributes) %}
{%- if data.asInput -%}
    <input class="{{ _self.class(data, classes) }}"
        {{ _self.attributes(data, attributes) }}
        type="submit" value="{{ data.label }}">
{%- else -%}
    {% set tag = data.url ? "a" : "button" %}
    <{{ tag }}
        {% if data.url %}href="{{ data.url }}"{% endif %}
        class="{{ _self.class(data, classes) }}"
        {{ _self.attributes(data, attributes) }}>
        {% if data.icon %}
        <span class="Icon Icon--{{ data.icon }}"></span>
        {# Buttons with labels have their labels wrapped in a span,
           along with an intentional whitespace between the icon and label. #}
        <span>
        {% endif %}
        {{ data.label }}
        {% if data.icon %}
        </span>
        {% endif %}
    </{{ tag }}>
{%- endif -%}
{% endmacro %}

{#
    The default scalar values from the codebehind for style and size match what
    Twitter's templates use, so they work. In the future, a macro to map enum
    to a CSS class name, etc. may be required.
#}
{% macro class(data, classes) %}
EdgeButton EdgeButton--{{ data.style.value }} EdgeButton--{{ data.size.value }} {{ classes|join(' ') }}
{% endmacro %}

{% macro attributes(data, attributes) %}
{%- for name, value in data.attributes -%}
data-{{ name }}="{{ value }}"
{%- endfor -%}
{% endmacro %}