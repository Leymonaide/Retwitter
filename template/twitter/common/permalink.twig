{# We use a null data parameter to represent the empty overlay used on all standard pages
   other than the cold-loaded permalink page. #}
{% macro render(data) %}
    {% types {
        data: "Retwitter\\Page\\Permalink\\PermalinkOverlay|null",
    } %}
    <div id="permalink-overlay" class="{{ [
        'PermalinkOverlay',
        'PermalinkOverlay-with-background',
        data is not null ? 'load-at-boot',
    ]|join(' ') }}">
        <div class="PermalinkProfile-dismiss modal-close-fixed">
            <span class="Icon Icon--close"></span>
        </div>
        {# TODO: The buttons #}
        {% if data is not null %}
            {{ _self.render_cold_loaded_permalink_wrapper(data) }}
        {% else %}
            {# Placeholder permalink overlay content: #}
            <div class="PermalinkOverlay-modal">
                <div class="PermalinkOverlay-spinnerContainer u-hidden">
                    <div class="PermalinkOverlay-spinner"></div>
                </div>
                <div class="PermalinkOverlay-content">
                    <div class="PermalinkOverlay-body"></div>
                </div>
            </div>
        {% endif %}
    </div>
{% endmacro %}

{# Rendered directly in the case of AJAX requests. #}
{% macro render_overlay_body(data) %}
    {% types {
        data: "Retwitter\\Page\\Permalink\\PermalinkOverlay",
    } %}
    {% import "common/timeline.twig" as timeline %}
    <div class="{{ [
        'permalink-container',
        'permalink-container--withArrows',
    ]|join(' ') }}" style="opacity: 1">
        {# PermalinkProfile #}

        {# TODO: Self-threads have the classes "self-thread-permalink-with-descendant" and
        "self-thread-permalink". These classes are responsible for handling the drawing
        of the line connecting the tweets (RWeb self-threads lack this design) #}
        <div class="{{ [
                'permalink',
                'light-inline-actions',
                'stream-uncapped',
                'has-replies',
                'original-permalink-page',
            ]|join(' ') }}" role="main">
            {# TweetArrows #}
            {# in reply tos #}
            <div class="permalink-inner permalink-tweet-container">
                {{ _self.render_permalink_tweet(
                    data.conversation.permalinkedTweetCtx.tweet, {
                        isLoggedIn: app.isLoggedIn(),
                        isPermalinkTweet: true,
                        openedTweet: true,
                        userActions: data.conversation.permalinkedTweetCtx.userActions,
                    }) }}
            </div>
            <div data-component-context="replies" class="replies-to permalink-inner permalink-replies">
                <div class="tweets-wrapper">
                    <div class="ThreadedDescendents" id="descendents">
                        <div data-min-position="" data-max-position="" class="stream-container">
                            {{ timeline.render_stream(
                                data.conversation.repliesStream, {
                                    streamComponentContext: "replies",
                                    render_stream_item: {
                                        context: _self,
                                        macro_name: "_render_permalink_stream_item",
                                    },
                                }
                            ) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro render_cold_loaded_permalink_wrapper(data) %}
    {% types {
        data: "Retwitter\\Page\\Permalink\\PermalinkOverlay",
    } %}
    <div id="permalink-overlay-dialog" class="PermalinkOverlay-modal" role="dialog" aria-labelledby="permalink-overlay-header">
        <div tabindex="0" class="js-first-tabstop"></div>
        <div class="PermalinkOverlay-content" role="document">
            <div data-background-path="/camocamo_d"{# temporary #}
                class="PermalinkOverlay-body">
                {{ _self.render_overlay_body(data) }}
            </div>
        </div>
    </div>
{% endmacro %}

{% macro _render_permalink_stream_item(item, template_context = {}) %}
    {% types {
        conversation: "Retwitter\\Page\\Common\\Timeline\\MTimelineItemUnion",
        template_context: "object",
    } %}
    {% import "common/timeline.twig" as timeline %}
    {% if item.conversation %}
        {{ _self.render_threaded_conversation(item.conversation, template_context) }}
    {% else %}
        {{ timeline.render_stream_item_default(item, template_context) }}
    {% endif %}
{% endmacro %}

{% macro render_threaded_conversation(conversation, extra) %}
    {# ThreadedConversation is a special type of conversation renderer that only
       appears on the timelines of permalinks, which are the tweet popups. All
       other timelines use conversation-module instead. I do not know why this
       is the case, but it's whatever.
       
       For now, all ThreadedConversation and conversation-module share the same
       models. This may change in the future. #}
    {% types {
        conversation: "Retwitter\\Page\\Common\\Timeline\\MConversation",
        extra: "object",
    } %}
    {% import "common/timeline.twig" as timeline %}
    {% if conversation.items|length == 1 and conversation.items[0].tweetUnion %}
        <div class="ThreadedConversation--loneTweet">
            {{ timeline.render_stream_item_tweet(conversation.items[0].tweetUnion, {
                componentContext: extra.streamComponentContext ?? null
            }) }}
        </div>
    {% else %}
        <li class="ThreadedConversation">
            <ol class="stream-items">
                {% for item in conversation.items %}
                    {% if item.tweetUnion %}
                        <div class="ThreadedConversation-tweet {{ loop.last ? "last" }}">
                            {{ timeline.render_stream_item_tweet(item.tweetUnion, {
                                componentContext: extra.streamComponentContext ?? null
                            }) }}
                        </div>
                    {% endif %}
                {% endfor %}
            </ol>
        </li>
    {% endif %}
{% endmacro %}

{% macro render_permalink_tweet(tweet, template_context = {}) %}
    {% types {
        tweet: "Retwitter\\Page\\Common\\Timeline\\MTweet",
        template_context: "object",
    } %}
    {% import "core/macros.twig" as core %}
    {% import "common/timeline.twig" as timeline %}
    {# TODO: Analyze classes. #}
    {{ timeline.tweet_begin(tweet, template_context) }}
        {{ timeline.render_tweet_context(tweet) }}
        <div class="content clearfix">
            <div class="permalink-header">
                {{ timeline.render_tweet_header(tweet, template_context) }}
            </div>
        </div>
        {{ timeline.render_tweet_main_body(tweet, template_context) }}
        <div class="client-and-actions">
            <span class="metadata">
                <span>{{ tweet.getTimeTooltipForPresentation() }}</span>
            </span>
        </div>
        {{ timeline.render_tweet_footer(tweet) }}
    {{ timeline.tweet_end(tweet, template_context) }}
{% endmacro %}

