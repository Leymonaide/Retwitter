{% macro render(data) %}
    {% types {
        data: "Retwitter\\Page\\Permalink\\PermalinkOverlay",
    } %}
    {% import "common/timeline.twig" as timeline %}
    <div id="permalink-overlay" class="{{ [
        'PermalinkOverlay',
        'PermalinkOverlay-with-background',
        'load-at-boot',
    ]|join(' ') }}">
        {# TODO: The buttons #}
        <div id="permalink-overlay-dialog" class="PermalinkOverlay-modal" role="dialog" aria-labelledby="permalink-overlay-header">
            <div tabindex="0" class="js-first-tabstop"></div>
            <div class="PermalinkOverlay-content" role="document">
                <div data-background-path="/i/status/1"{# temporary #}
                    class="PermalinkOverlay-body">
                    <div class="{{ [
                            'permalink-container',
                            'permalink-container--withArrows',
                        ]|join(' ') }}" style="opacity: 1">
                        {# PermalinkProfile #}
                        <div class="{{ [
                                'permalink',
                                'light-inline-actions',
                                'stream-uncapped',
                                'has-replies',
                                'original-permalink-page',
                            ]|join(' ') }}" role="main">
                            {# TweetArrows #}
                            {# in reply tos #}
                            <div class="permalink-inner permalink-tweet-container">
                                {{ timeline.render_tweet(
                                    data.threadedConversation.getTargetTweet().tweet, {
                                        isLoggedIn: app.isLoggedIn(),
                                        isPermalinkTweet: true,
                                        openedTweet: true,
                                    }) }}
                            </div>
                            <div data-component-context="replies" class="replies-to permalink-inner permalink-replies">
                                <div class="tweets-wrapper">
                                    <div class="ThreadedDescendents" id="descendents">
                                        <div data-min-position="" data-max-position="" class="stream-container">
                                            {{ timeline.render_stream(
                                                data.threadedConversation.timeline.stream, {
                                                    streamComponentContext: "replies",
                                                    useThreadedConversation: true,
                                                }
                                            ) }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro _render_permalink_stream_item(item, template_context = {}) %}
    {% types {
        conversation: "Retwitter\\Page\\Common\\Timeline\\MTimelineItemUnion",
        template_context: "object",
    } %}
    {% import "common/timeline.twig" as timeline %}
    {% if item.tweetUnion %}
        <div class="ThreadedConversation--loneTweet">
            {{ _self.render_stream_item_tweet(item.tweetUnion, {
                componentContext: extra.streamComponentContext ?? null
            }) }}
        </div>
    {% else %}
        {{ timeline.render_stream_item_default(item, template_context) }}
    {% endif %}
{% endmacro %}