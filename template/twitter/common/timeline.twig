{% macro render_timeline(timeline, extra) %}
    {% types {
        timeline: "Retwitter\\Page\\Common\\Timeline\\MTimeline",
        extra: "object",
    } %}
    <div id="timeline" class="{{ [
            ...extra.timelineClasses,
        ]|join(' ') }}">
        <div class="stream-container {# Home classes: #}{{ [
                null ? "conversations-enabled",
                null ? "js-request-more-stream-items",
            ]|join(" ") }}"
            {# XXX(isabella): These position attributes are not on the home timeline. #}
            data-max-position=""
            data-min-position="" {# TODO: Figure positions out. #}>
            <div class="stream-item js-new-items-bar-container"></div>
            {% if not extra.streamFooter %}
                {% set streamFooter %}
                    <div class="stream-footer ">
                        <div class="timeline-end has-items has-more-items">
                            <div class="stream-end">
                                <div class="stream-end-inner">
                                    <span class="Icon Icon--large Icon--logo"></span>

                                    <p class="empty-text">
                                        @USERNAME non ha ancora twittato.
                                    </p>

                                    <p><button type="button" class="btn-link back-to-top hidden">Torna su ↑</button></p>
                                </div>
                            </div>
                            <div class="stream-loading">
                                <div class="stream-end-inner">
                                    <span class="spinner" title="Caricamento in corso..."></span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endset %}
            {% endif %}
            {{ _self.render_stream(timeline.stream, {
                streamFooter: extra.streamFooter ?? streamFooter,
            }) }}
        </div>
    </div>
{% endmacro %}

{% macro render_stream(stream, extra) %}
    {% types {
        stream: "Retwitter\\Page\\Common\\Timeline\\MStream",
        extra: "object",
    } %}
    <div class="stream">
        <ol id="stream-items-id" class="{{ [
                'stream-items',
                'js-navigable-stream',
            ]|join(' ') }}">
            {% for tweet in stream.tweets %}
                <li id="stream-item-tweet-{{ tweet.id }}" class="{{ [
                        'js-stream-item',
                        'stream-item',
                        tweet.isUserPinned ? 'js-pinned',
                    ]|join(' ') }}" data-item-id="{{ tweet.id }}"
                    data-item-type="tweet" data-suggestion-json="{# TODO #}">
                    {{ _self.render_tweet(tweet) }}
                </li>
            {% endfor %}
        </ol>
        {% if extra.streamFooter %}
            {{ extra.streamFooter }}
        {% endif %}
        <div class="stream-fail-container">
            <div class="{{ [
                    "js-stream-whale-end",
                    "stream-whale-end",
                    "stream-placeholder",
                    "centered-placeholder",
                 ]|join(" ") }}">
                <div class="stream-end-inner">
                    <h2 class="title">Loading seems to be taking a while.</h2>
                    <p>
                        Twitter may be over capacity or experiencing a momentary hiccup.
                        <a role="button" href="https://twitter.com/#" class="try-again-after-whale">Try again</a>
                        or visit <a target="_blank" href="http://status.twitter.com/" rel="noopener">Twitter Status</a>
                        for more information.
                    </p>
                </div>
            </div>
        </div>
        <ol class="hidden-replies-container"></ol>
    </div>
{% endmacro %}

{% macro render_tweet(tweet) %}
    {% types {
        tweet: "Retwitter\\Page\\Common\\Timeline\\MTweet",
    } %}
    {% import "core/macros.twig" as core %}
    {% set TweetSocialContext = enum("Retwitter\\Page\\Common\\Timeline\\TweetSocialContext") %}
    {# TODO: Analyze classes. #}
    <div class="{{ [
            'tweet',
            'js-stream-tweet',
            'js-actionable-tweet',
            'original-tweet', # TODO: Discern
            'js-original-tweet',
            tweet.socialContext ? 'tweet-has-context',
            tweet.isUserPinned ? 'user-pinned',
            tweet.invertedColors ? "Tweet--invertedColors",
        ]|join(' ') }}"
        data-tweet-id="{{ tweet.id }}"
        data-item-id="{{ tweet.id }}"
        data-permalink-path="{{ tweet.getUrl() }}"
        data-conversation-id="{{ tweet.conversationId }}"
        data-tweet-nonce="{# Tweet ID, maybe with random ID after #}"
        {# TODO: The below information is wrong. Sometimes tweets just get blank
           stat buttons, which are initialized on the client side. Figure out
           what conditions this happens under and replicate, or settle for an
           inaccurate implementation (which I imagine is fine) #}
        {# data-tweet-stat-initialized seems to only appear at template time as
           "true" if the tweet has any stat information at template time. #}
        {% if not tweet.areAllStatsEmpty() %}
            data-tweet-stat-initialized="true"
        {% endif %}
        {% if tweet.retweetId %}
            data-retweet-id="{{ tweet.retweetId }}"
        {% endif %}
        {% if tweet.isRetweet %}
            data-retweeter="{{ tweet.retweeterUsername }}"
        {% endif %}
        data-screen-name="{{ tweet.author.screenName }}"
        data-name="{{ core.simple_text(tweet.author.name) }}"
        data-user-id="{{ tweet.userId }}"
        data-you-follow="false"
        data-follows-you="false"
        data-you-block="false"
        data-reply-to-users-json="{# TODO. #}"
        data-disclosure-type=""
        {# The following don't seem to be there for most tweets, just the one I
           happened to start copying from.
        data-card2-type="audio"
        data-has-cards="true"
        #}
        >
        <div class="context">
            {% if tweet.socialContext.type == TweetSocialContext.Retweet %}
                <div class="tweet-context with-icn ">
                    <span class="Icon Icon--small Icon--retweeted"></span>
                    <span class="js-retweet-text">
                        {% with %}
                            {%- set profile_link -%}
                                <a class="pretty-link js-user-profile-link"
                                    href="{{ tweet.socialContext.retweeterUrl }}"
                                    data-user-id="{{ tweet.socialContext.retweeterUserId }}"
                                    rel="noopener">
                                    <b>{{ core.text(tweet.socialContext.retweeterDisplayName) }}</b>
                                </a>
                            {%- endset -%}
                            {{ app.i18n.formatHtml("common", "tweet_social_context_retweeted", profile_link|safeHtml) }}
                        {% endwith %}
                    </span>
                </div>
            {% elseif tweet.socialContext.type == TweetSocialContext.Pin %}
                <div class="tweet-context with-icn pinned">
                    <span class="Icon Icon--small Icon--pinned u-TextUserColor"></span>
                    <span class="js-pinned-text" data-aria-label-part="">
                        {{ app.i18n.get("common", "tweet_social_context_pinned") }}
                    </span>
                </div>
            {% endif %}
        </div>
        <div class="content">
            <div class="stream-item-header">
                <a class="{{ [
                        'account-group',
                        'js-account-group',
                        'js-action-profile',
                        'js-user-profile-link',
                        'js-nav',
                    ]|join(' ') }}"
                    href="/{{ tweet.author.screenName }}"
                    data-user-id="{{ tweet.userId }}">
                    <img class="avatar js-action-profile-avatar"
                        src="{{ tweet.author.avatarUrl }}"
                        alt="{# Profile avatar accessibility text: I don't know what this would be. #}">
                    <span class="FullNameGroup">
                        <strong class="fullname show-popup-with-id u-textTruncate"
                            data-aria-label-part="">
                            {{ core.text(tweet.author.name) }}
                        </strong>
                        {{ core.user_badges(tweet.author.badges) }}
                        <span class="UserNameBreak">&nbsp;</span>
                    </span>
                    <span class="username u-dir u-textTruncate" dir="ltr"
                        data-aria-label-part="">
                        @<b>{{ tweet.author.screenName }}</b>
                    </span>
                </a>
                <small class="time">
                    &nbsp;
                    <a class="tweet-timestamp js-permalink js-nav js-tooltip"
                        href="{{ tweet.getUrl() }}"
                        title="{{ tweet.getTimeTooltipForPresentation() }}"
                        data-conversation-id="{{ tweet.conversationId }}">
                        <span class="_timestamp js-short-timestamp"
                            data-aria-label-part="last"
                            data-time="{{ tweet.getTimeSeconds() }}"
                            data-time-ms="{{ tweet.getTimeMilliseconds() }}"
                            data-long-form="true">{{ tweet.getTimeForPresentation() }}</span>
                    </a>
                </small>

                
                <div class="{{ [
                        'ProfileTweet-action',
                        'ProfileTweet-action--more',
                        'js-more-ProfileTweet-actions',
                    ]|join(' ') }}">
                    <div class="dropdown">
                        <button class="{{ [
                                'ProfileTweet-actionButton',
                                'u-textUserColorHover',
                                'dropdown-toggle',
                                'js-dropdown-toggle',
                            ]|join(' ') }}"
                            type="button" aria-haspopup="true">
                            <div class="IconContainer js-tooltip"
                                title="{{ app.i18n.get("common", "more_tooltip") }}">
                                <span class="Icon Icon--caretDownLight Icon--small"></span>
                                <span class="u-hiddenVisually"></span>
                            </div>
                        </button>
                        <div class="dropdown-menu is-autoCentered">
                            <div class="dropdown-caret">
                                <div class="caret-outer"></div>
                                <div class="caret-inner"></div>
                            </div>
                            <ul>
                                <li class="copy-link-to-tweet js-actionCopyLinkToTweet">
                                    <button class="dropdown-link" type="button">
                                        {{ app.i18n.get("common", "tweet_menu_copy_link") }}
                                    </button>
                                </li>
                                <li class="embed-link js-actionEmbedTweet" data-nav="embed_tweet">
                                    <button class="dropdown-link" type="button">
                                        {{ app.i18n.get("common", "tweet_menu_embed") }}
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="js-tweet-text-container">
                <p class="{{ [
                        'TweetTextSize',
                        'TweetTextSize--normal',
                        'js-tweet-text',
                        'tweet-text',
                    ]|join(' ') }}"
                    data-aria-label-part="0" lang="{{ tweet.lang }}">{# TODO: Improve #}{#
                    #}{{- core.tweet_text(tweet.fullText) }}{#
                #}</p>
            </div>
            {% if tweet.media is not empty %}
                {{ _self.tweet_adaptive_media(tweet.media) }}
            {% endif %}
            {% if tweet.quotedTweet.tweet %}
                {{ _self.quoted_tweet(tweet.quotedTweet.tweet) }}
            {% elseif tweet.quotedTweet.tombstone %}
                <div class="Tombstone">
                    <span class="Tombstone-label">
                        {{ tweet.quotedTweet.tombstone.message }}
                    </span>
                </div>
            {% endif %}
            {#}
            <div class="card2 js-media-container" data-card2-name="audio">
                TODO: What is this element, exactly? Does not exist on all
                Tweets either.
            </div>
            #}
            <div class="stream-item-footer">
                <div class="ProfileTweet-actionCountList u-hiddenVisually">
                    {% for tweet_action in tweet.actionStrip.actions %}
                        {{ _self.tweet_action_count(tweet, tweet_action) }}
                    {% endfor %}
                </div>
                <div class="ProfileTweet-actionList js-actions" role="group"
                    aria-label="Tweet actions">
                    {% for tweet_action in tweet.actionStrip.actions %}
                        {{ _self.tweet_action_button(tweet, tweet_action) }}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro tweet_adaptive_media(tweet_media_arr) %}
    {% types {
        tweet_media: "array<Retwitter\\Page\\Common\\Timeline\\MTweetMedia>",
    } %}
    
    <div class="AdaptiveMediaOuterContainer">
        {# The "is-square" class appears to be used exactly under the condition
           down there. I don't know why it's called that, but whatever. #}
        <div class="{{ [
                'AdaptiveMedia',
                tweet_media_arr|length == 1 ? 'is-square',
            ]|join(' ') }}">
            <div class="AdaptiveMediaContainer">
                {% if tweet_media_arr|length == 1 %}
                    <div class="AdaptiveMedia-singlePhoto"
                        {# Style here controls the entire height of the media
                           embed. Of course, this also needs to be calculated
                           dynamically. #}
                        {{"style"}}="padding-top: calc({{ 
                            tweet_media_arr[0].getAspectRatioForCss() 
                            }} * 100% - 0.5px);">
                        {{ _self.adaptive_media_photo_container(
                            tweet_media_arr[0],
                            vertical: true,
                        ) }}
                    </div>
                {% elseif tweet_media_arr|length == 2 %}
                    <div class="AdaptiveMedia-doublePhoto">
                        <div class="AdaptiveMedia-halfWidthPhoto">
                            {{ _self.adaptive_media_photo_container(
                                tweet_media_arr[0],
                                vertical: false,
                            ) }}
                        </div>
                        <div class="AdaptiveMedia-halfWidthPhoto">
                            {{ _self.adaptive_media_photo_container(
                                tweet_media_arr[1],
                                vertical: false,
                            ) }}
                        </div>
                    </div>
                {% elseif tweet_media_arr|length == 3 %}
                    <div class="AdaptiveMedia-triplePhoto">
                        <div class="AdaptiveMedia-twoThirdsWidthPhoto">
                            {{ _self.adaptive_media_photo_container(
                                tweet_media_arr[0],
                                vertical: false,
                            ) }}
                        </div>
                        <div class="AdaptiveMedia-halfHeightPhotoContainer">
                            <div class="AdaptiveMedia-halfHeightPhoto">
                                {{ _self.adaptive_media_photo_container(
                                    tweet_media_arr[1],
                                    vertical: true,
                                ) }}
                            </div>
                            <div class="AdaptiveMedia-halfHeightPhoto">
                                {{ _self.adaptive_media_photo_container(
                                    tweet_media_arr[2],
                                    vertical: true,
                                ) }}
                            </div>
                        </div>
                    </div>
                {% elseif tweet_media_arr|length == 4 %}
                    <div class="AdaptiveMedia-quadPhoto">
                        <div class="AdaptiveMedia-threeQuartersWidthPhoto">
                            {{ _self.adaptive_media_photo_container(
                                tweet_media_arr[0],
                                vertical: tweet_media_arr[0].aspectRatio > 1.0,
                            ) }}
                        </div>
                        <div class="AdaptiveMedia-thirdHeightPhotoContainer">
                            <div class="AdaptiveMedia-thirdHeightPhoto">
                                {{ _self.adaptive_media_photo_container(
                                    tweet_media_arr[1],
                                    vertical: tweet_media_arr[1].aspectRatio > 1.0,
                                ) }}
                            </div>
                            <div class="AdaptiveMedia-thirdHeightPhoto">
                                {{ _self.adaptive_media_photo_container(
                                    tweet_media_arr[2],
                                    vertical: tweet_media_arr[2].aspectRatio > 1.0,
                                ) }}
                            </div>
                            <div class="AdaptiveMedia-thirdHeightPhoto">
                                {{ _self.adaptive_media_photo_container(
                                    tweet_media_arr[3],
                                    vertical: tweet_media_arr[3].aspectRatio > 1.0,
                                ) }}
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endmacro %}

{% macro adaptive_media_photo_container(tweet_media, vertical = true) %}
    <div class="{{ [
          'AdaptiveMedia-photoContainer',
           'js-adaptive-photo',
        ]|join(' ') }}"
        data-image-url="{{ tweet_media.mediaUrl }}"
        data-element-context="platform_photo_card"
        data-temp-aspect="{{tweet_media.getAspectRatio()}}"
        {# CONSIDER: The dominant color does not seem to be report by Twitter's
           API anymore, so this will probably have to be worked around in some
           way. #}
        style="background-color:rgba(46,53,64,1.0);"
        data-dominant-color="[46,53,64]">
        <img data-aria-label-part=""
          src="{{ tweet_media.mediaUrl }}"
          alt=""
          {# The printing here is to avoid IDE static analysis false positives. #}
          {{"style"}}="{{ vertical
                        ? tweet_media.getYOffsetForCss()
                        : tweet_media.getXOffsetForCss() }}">
    </div>
{% endmacro %}

{% macro quoted_tweet(tweet) %}
    {% types {
        tweet: "Retwitter\\Page\\Common\\Timeline\\MTweet",
    } %}
    {% import "core/macros.twig" as core %}
    <div class="QuoteTweet u-block js-tweet-details-fixer">
        <div class="QuoteTweet-container">
            <a href="{{ tweet.getUrl() }}"
            class="QuoteTweet-link js-nav"
            aria-hidden="true">
            </a>
            <div class="{{ [
                    'QuoteTweet-innerContainer',
                    'u-cf',
                    'js-permalink',
                    'js-media-container',
                ]|join(' ') }}"
                data-item-id="{{ tweet.id }}"
                data-item-type="tweet"
                data-screen-name="{{ tweet.author.screenName }}"
                data-user-id="{{ tweet.author.id }}"
                href="{{ tweet.getUrl() }}"
                data-conversation-id="{{ tweet.id }}">
                <div class="tweet-content">
                    {% if tweet.media|length > 0 %}
                        {{ _self.quote_media(tweet.media) }}
                    {% endif %}
                    <div class="QuoteTweet-authorAndText u-alignTop">
                        <div class="{{ [
                                'QuoteTweet-originalAuthor',
                                'u-cf',
                                'u-textTruncate',
                                'stream-item-header',
                                'account-group',
                                'js-user-profile-link',
                            ]|join(' ') }}">
                            <b class="QuoteTweet-fullname u-linkComplex-target">
                                {{ core.text(tweet.author.name) }}
                            </b>
                            {{ core.user_badges(tweet.author.badges) }}
                            <span class="UserNameBreak">&nbsp;</span>
                            <span class="username u-dir" dir="ltr">
                                @<b>{{ tweet.author.screenName }}</b>
                            </span>
                        </div>
                        <div class="QuoteTweet-text tweet-text u-dir" dir="ltr">
                            {{- core.tweet_text(tweet.fullText) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro quote_media(tweet_media_arr) %}
    {% types {
        tweet_media_arr: "array<Retwitter\\Page\\Common\\Timeline\\MTweetMedia>",
    } %}

    <div class="QuoteMedia">
        <div class="QuoteMedia-container js-quote-media-container">
            {% if tweet_media_arr|length == 1 %}
                <div class="QuoteMedia-singlePhoto">
                    {{ _self.quote_media_photo_container(
                        tweet_media_arr[0],
                        vertical: tweet_media_arr[0].aspectRatio > 1.0,
                    ) }}
                </div>
            {% elseif tweet_media_arr|length == 2 %}
                <div class="QuoteMedia-doublePhoto">
                    <div class="QuoteMedia-halfPhoto">
                        {{ _self.quote_media_photo_container(
                            tweet_media_arr[0],
                            vertical: tweet_media_arr[0].aspectRatio < 1.0,
                        ) }}
                    </div>
                    <div class="QuoteMedia-halfPhoto">
                        {{ _self.quote_media_photo_container(
                            tweet_media_arr[1],
                            vertical: tweet_media_arr[1].aspectRatio < 1.0,
                        ) }}
                    </div>
                </div>
            {% elseif tweet_media_arr|length == 3 %}
                <div class="QuoteMedia-triplePhoto">
                    <div class="QuoteMedia-halfPhoto">
                        {{ _self.quote_media_photo_container(
                            tweet_media_arr[0],
                            vertical: tweet_media_arr[0].aspectRatio > 1.0,
                        ) }}
                    </div>
                    <div class="QuoteMedia-quarterPhotoContainer">
                        <div class="QuoteMedia-quarterPhoto">
                            {{ _self.quote_media_photo_container(
                                tweet_media_arr[1],
                                vertical: tweet_media_arr[1].aspectRatio > 1.0,
                            ) }}
                        </div>
                        <div class="QuoteMedia-quarterPhoto">
                            {{ _self.quote_media_photo_container(
                                tweet_media_arr[2],
                                vertical: tweet_media_arr[2].aspectRatio > 1.0,
                            ) }}
                        </div>
                    </div>
                </div>
            {% elseif tweet_media_arr|length == 4 %}
                <div class="QuoteMedia-quadPhoto">
                    <div class="QuoteMedia-quarterPhoto">
                        {{ _self.quote_media_photo_container(
                            tweet_media_arr[0],
                            vertical: tweet_media_arr[0].aspectRatio > 1.0,
                        ) }}
                    </div>
                    <div class="QuoteMedia-quarterPhoto">
                        {{ _self.quote_media_photo_container(
                            tweet_media_arr[1],
                            vertical: tweet_media_arr[1].aspectRatio > 1.0,
                        ) }}
                    </div>
                    <div class="QuoteMedia-quarterPhoto">
                        {{ _self.quote_media_photo_container(
                            tweet_media_arr[2],
                            vertical: tweet_media_arr[2].aspectRatio > 1.0,
                        ) }}
                    </div>
                    <div class="QuoteMedia-quarterPhoto">
                        {{ _self.quote_media_photo_container(
                            tweet_media_arr[3],
                            vertical: tweet_media_arr[3].aspectRatio > 1.0,
                        ) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% macro quote_media_photo_container(tweet_media, vertical = true) %}
    {% types {
        tweet_media: "Retwitter\\Page\\Common\\Timeline\\MTweetMedia",
    } %}

    <div class="QuoteMedia-photoContainer js-quote-photo"
        data-image-url="{{ tweet_media.mediaUrl }}"
        data-element-context="platform_photo_card"
        style="background-color:rgba(46,53,64,1.0);"
        data-dominant-color="[46,53,64]">
        <img data-aria-label-part=""
            src="{{ tweet_media.mediaUrl }}"
            alt=""
            {{"style"}}="{{ vertical
                        ? tweet_media.getYOffsetForCss()
                        : tweet_media.getXOffsetForCss() }}">
    </div>
{% endmacro %} 

{%- macro get_tweet_action_name(tweet_action) -%}
    {% types {
        tweet_action: "Retwitter\\Page\\Common\\Timeline\\MTweetAction",
    } %}

    {% set TweetAction = enum("Retwitter\\Page\\Common\\Timeline\\TweetAction") %}
    {%- if tweet_action.actionType == TweetAction.Reply -%}
        reply
    {%- elseif tweet_action.actionType == TweetAction.Retweet -%}
        retweet
    {%- elseif tweet_action.actionType == TweetAction.Favorite -%}
        favorite
    {%- endif -%}
{%- endmacro -%}

{# Tweet action count for accessibility. #}
{% macro tweet_action_count(tweet, tweet_action) %}
    {% types {
        tweet: "Retwitter\\Page\\Common\\Timeline\\MTweet",
        tweet_action: "Retwitter\\Page\\Common\\Timeline\\MTweetAction",
    } %}
    
    {% set action_name = _self.get_tweet_action_name(tweet_action)|spaceless %}

    <span class="{{ [
        'ProfileTweet-action--' ~ action_name,
        'u-hiddenVisually',
    ]|join(' ') }}">
        <span class="ProfileTweet-actionCount"
            data-tweet-stat-count="{{ tweet_action.count }}">
            <span id="profile-tweet-action-{{ action_name }}-count-aria-{{ tweet.id }}"
                class="ProfileTweet-actionCountForAria"
                data-aria-label-part="">{{ tweet_action.accessibilityText }}</span>
        </span>
    </span>
{% endmacro %}

{% macro tweet_action_button(tweet, tweet_action) %}
    {% types {
        tweet: "Retwitter\\Page\\Common\\Timeline\\MTweet",
        tweet_action: "Retwitter\\Page\\Common\\Timeline\\MTweetAction",
    } %}
    {% set TweetAction = enum("Retwitter\\Page\\Common\\Timeline\\TweetAction") %}
    {% set action_name = _self.get_tweet_action_name(tweet_action)|spaceless %}
    {% if tweet_action.actionType == TweetAction.Reply %}
        {% set action_container_classes = [ 'ProfileTweet-action--reply' ] %}
        {% set action_button_classes = [ 
            'js-actionButton',
            'js-actionReply',
        ] %}
        {% set action_icon = _self.tweet_action_icon_std("reply") %}
    {% elseif tweet_action.actionType == TweetAction.Retweet %}
        {% set action_container_classes = [
            'ProfileTweet-action--retweet',
            'js-toggleState',
            'js-toggleRt',
        ] %}
        {% set action_button_classes = [
            'js-actionButton',
            'js-actionRetweet',
        ] %}
        {% set action_icon = _self.tweet_action_icon_std("retweet") %}

        {% set has_undo_button = true %}
        {% set undo_button_classes = action_button_classes %}
    {% elseif tweet_action.actionType == TweetAction.Favorite %}
        {% set action_container_classes = [
            'ProfileTweet-action--favorite',
            'js-toggleState',
        ] %}
        {% set action_button_classes = [
            'js-actionButton',
            'js-actionFavorite',
        ] %}
        {% set action_icon = _self.tweet_action_icon_favorite() %}

        {% set has_undo_button = true %}
        {% set undo_button_classes = [
            'ProfileTweet-action--unfavorite',
            'u-linkClean',
            'js-actionButton',
            'js-actionFavorite',
        ] %}
    {% endif %}

    <div class="{{ [
            'ProfileTweet-action',
            ...action_container_classes,
        ]|join(' ') }}">
        {{ _self.tweet_action_button_inner(
            tweet,
            tweet_action,
            action_button_classes,
            action_name,
            action_icon,
        ) }}
        {% if has_undo_button %}
            {{ _self.tweet_action_button_undo(
                tweet,
                tweet_action,
                undo_button_classes,
                action_name,
                action_icon,
            ) }}
        {% endif %}
    </div>
{% endmacro %}

{% macro tweet_action_button_inner(
    tweet, tweet_action, action_button_classes, action_name, action_icon,
) %}
    {% types {
        tweet: "Retwitter\\Page\\Common\\Timeline\\MTweet",
        tweet_action: "Retwitter\\Page\\Common\\Timeline\\MTweetAction",
        action_button_classes: "string[]",
        action_name: "string",
        action_icon: "string",
    } %}
    <button class="{{ [
        'ProfileTweet-actionButton',
        ...action_button_classes,
    ]|join(' ') }}"
    data-modal="ProfileTweet-{{ action_name }}"
    type="button"
    aria-describedby="profile-tweet-action-{{ action_name }}-count-aria-{{ tweet.id }}">
    <div class="IconContainer js-tooltip" title="{{ tweet_action.tooltip }}">
        {{ action_icon }}
        <span class="u-hiddenVisually">{{ tweet_action.tooltip }}</span>
    </div>{#
    #}&nbsp;{#
    #}<span class="ProfileTweet-actionCount"
        data-tweet-stat-count="{{ tweet_action.count }}">
        <span class="ProfileTweet-actionCountForPresentation"
            aria-hidden="true">{{ tweet_action.formattedCount }}</span>
    </span>
    </button>
{% endmacro %}

{# It's cleaner to just separate this. Although this is superficially similar to
   tweet_action_button_inner, it does subtly differ enough to justify
   distinction. #}
{% macro tweet_action_button_undo(
    tweet, tweet_action, action_button_classes, action_name, action_icon,
) %}
    {% types {
        tweet: "Retwitter\\Page\\Common\\Timeline\\MTweet",
        tweet_action: "Retwitter\\Page\\Common\\Timeline\\MTweetAction",
        action_button_classes: "string[]",
        action_name: "string",
        action_icon: "string",
    } %}
    <button class="{{ [
        'ProfileTweet-actionButtonUndo',
        ...action_button_classes,
    ]|join(' ') }}" type="button">
    <div class="IconContainer js-tooltip" title="{{ tweet_action.undoTooltip }}">
        {{ action_icon }}
        <span class="u-hiddenVisually">{{ tweet_action.pastTenseTooltip }}</span>
    </div>{#
    #}&nbsp;{#
    #}<span class="ProfileTweet-actionCount">
        <span class="ProfileTweet-actionCountForPresentation"
            aria-hidden="true">{{ tweet_action.formattedCount }}</span>
    </span>
    </button>
{% endmacro %}

{% macro tweet_action_icon_std(icon_type) %}
    {% types { icon_type: "string" } %}
    <span class="Icon Icon--medium Icon--{{ icon_type }}"></span>
{% endmacro %}

{% macro tweet_action_icon_favorite() %}
    <span class="Icon Icon--heart Icon--medium" role="presentation"></span>
    <div class="HeartAnimation"></div>
{% endmacro %}