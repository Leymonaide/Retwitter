{% extends "core/core.twig" %}

{% set retwitter_g_js_page_name = "profile" %}
{% set retwitter_g_js_page_context = "profile" %}
{% set retwitter_g_boot_module = "app/pages/profile/highline_landing" %}

{%- set retwitter_g_js_page_config -%}
    {%- autoescape "js" -%}
    {%- with { c: app.page.jsConfig } -%}
    {% types {
        c: "\\Retwitter\\Page\\Profile\\MProfileJsConfigInfo"
    } %}
    {# TODO: Various properties. #}
    "profile_user": {
        "id": {{ c.id }},
        "id_str": {{ c.id|json_encode|raw }},
        "name": {{ c.name|json_encode|raw }},
        "screen_name": {{ c.screenName|json_encode|raw }},
        "location": {{ c.location|json_encode|raw }},
        "url": {{ c.url|json_encode|raw }},
        "description": {{ c.description|json_encode|raw }},
        "protected": {{ c.protected|json_encode|raw }},
        "followers_count": {{ c.followersCount|json_encode|raw }},
        "friends_count": {{ c.friendsCount|json_encode|raw }},
        "listed_count": {{ c.listedCount|json_encode|raw }},
        "created_at": {{ c.createdAt|json_encode|raw }},
        "favourites_count": {{ c.favouritesCount|json_encode|raw }},
        "utc_offset": null,
        "time_zone": null,
        "geo_enabled": true,
        "verified": {{ c.verified|json_encode|raw }},
        "statuses_count": {{ c.statusesCount|json_encode|raw }},
        "lang": "en",
        "contributors_enabled": false,
        "is_translator": false,
        "is_translation_enabled": false,
        "profile_background_color": "EBEBEB",
        "profile_background_image_url": {{ c.profileBackgroundUrl|json_encode|raw }},
        "profile_background_image_url_https": {{ c.profileBackgroundUrlHttps|json_encode|raw }},
        "profile_background_tile": {{ c.profileBackgroundTile|json_encode|raw }},
        "profile_image_url": {{ c.profileImageUrl|json_encode|raw }},
        "profile_image_url_https": {{ c.profileImageUrlHttps|json_encode|raw }},
        "profile_banner_url": {{ c.profileBannerUrl|json_encode|raw }},
        "profile_link_color": "990000",
        "profile_sidebar_border_color": "DFDFDF",
        "profile_sidebar_fill_color": "F3F3F3",
        "profile_text_color": "333333",
        "profile_use_background_image": true,
        "has_extended_profile": true,
        "default_profile": false,
        "default_profile_image": false,
        "following": null,
        "follow_request_sent": null,
        "notifications": null,
        "business_profile_state": "none",
        "translator_type": "regular"
    },
    "profile_id": 1
    {%- endwith -%}
    {%- endautoescape -%}
{%- endset -%}

{% block body_class %}
{% if not app.page.error %}
enhanced-mini-profile
ProfilePage
{% if not app.page.isGridTimeline %}
ProfilePage--withWarning
{% endif %}
no-nav-banners
{% endif %}
{% endblock %}

{% block page_class %}
{{ parent() }}
{% if app.page.error %}
wrapper
wrapper-profile
{% endif %}
{% endblock %}

{% set threeCol = true %}

{% macro profile_info(info) %}
    {% types {
        info: "Retwitter\\Page\\Profile\\MProfileInfo",
    } %}
    {% import "core/macros.twig" as core %}
    <div class="Grid Grid--withGutter">
        <div class="Grid-cell">
            <div class="ProfileSidebar ProfileSidebar--withLeftAlignment">
                <div class="ProfileHeaderCard">
                    {% apply spaceless %}
                    <h1 class="ProfileHeaderCard-name">
                        <a href="{{ info.profileUrl }}" class="ProfileHeaderCard-nameLink u-textInheritColor js-nav">{{ core.text(info.name) }}</a>
                        {% with { badges: info.badges } %}
                            <span class="ProfileHeaderCard-badges">
                                {{ core.user_badges(badges, true) }}
                            </span>
                        {% endwith %}
                    </h1>
                    {% endapply %}
                    <h2 class="ProfileHeaderCard-screenname u-inlineBlock u-dir" dir="ltr">
                        <a href="{{ info.profileUrl }}" class="ProfileHeaderCard-screennameLink u-linkComplex js-nav">
                            <span class="username u-dir" dir="ltr">
                                @<b class="u-linkComplex-target">{{ info.screenName }}</b>
                            </span>
                        </a>
                        {%- if info.followsYou -%}
                        <span class="FollowStatus">{{ app.i18n.get("common", "user_follows_you") }}</span>
                        {%- endif -%}
                    </h2>
                    <p class="ProfileHeaderCard-bio u-dir" dir="ltr">{{ core.text(info.bio, true) }}</p>
                    <div class="ProfileHeaderCard-location {{ not info.location ? "u-hidden" }}">
                        <span class="Icon Icon--geo Icon--medium" aria-hidden="true" role="presentation"></span>
                        <span class="ProfileHeaderCard-locationText u-dir" dir="ltr">
                            {{ core.text(info.location) }}
                        </span>
                    </div>
                    <div class="ProfileHeaderCard-url {{ not info.url ? "u-hidden" }}">
                        <span class="Icon Icon--url Icon--medium" aria-hidden="true" role="presentation"></span>
                        <span class="ProfileHeaderCard-urlText u-dir" dir="ltr">
                            {{ core.text(info.url.formattedString) }}
                        </span>
                    </div>
                    <div class="ProfileHeaderCard-joinDate">
                        <span class="Icon Icon--calendar Icon--medium" aria-hidden="true" role="presentation"></span>
                        <span class="ProfileHeaderCard-joinDateText u-dir" dir="ltr">
                            <span class="js-tooltip" title="{{ info.joinDate.title }}">
                                {{ info.joinDate.text }}
                            </span>
                        </span>
                    </div>
                    <div class="ProfileHeaderCard-birthdate {{ not info.birthDate ? "u-hidden" }}">
                        <span class="Icon Icon--balloon Icon--medium" aria-hidden="true" role="presentation"></span>
                        <span class="ProfileHeaderCard-birthdateText u-dir" dir="ltr">
                            <span class="js-tooltip" title="Public">
                                {{ info.birthDate }}
                            </span>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro protected_timeline(data) %}
    {% types {
        data: "Retwitter\\Page\\Profile\\MProtectedTimeline"
    } %}
    <div class=" ">
        <div class="ProtectedTimeline">
            <h2 id="content-main-heading" class="ProtectedTimeline-heading">{{
                app.i18n.get("profile", "protected_title")
            }}</h2>
            <p class="ProtectedTimeline-explanation">
                {% with %}
                    {% set username_html %}
                        <span class="{{ [
                            'username',
                            'u-dir',
                            'u-textTruncate',
                        ]|join(' ') }}" dir="ltr">@<b>{{ data.username }}</b></span>
                    {% endset %}
                    {{ app.i18n.formatHtml(
                        "profile",
                        "protected_explanation",
                        username_html|trim|safeHtml,
                    ) }}
                {% endwith %}
            </p>
        </div>
    </div>
{% endmacro %}

{% macro heading(data) %}
<div class="ProfileHeading">
    <div class="ProfileHeading-spacer"></div>
    <div class="ProfileHeading-content {{ data.noFill ? "ProfileHeading-content--noFill" }}">
        <h2 id="content-main-heading" class="ProfileHeading-title u-hiddenVisually">
            {{ data.title }}
        </h2>
        {% if data.tabs|length > 0 %}
        <ul class="ProfileHeading-toggle">
            {% for tab in data.tabs %}
            <li class="ProfileHeading-toggleItem {{ tab.active ? "is-active" : "u-textUserColor" }}" data-element-term="{{ tab.tab }}_toggle">
                {% if tab.active %}
                <span aria-hidden="true">{{ tab.label }}</span>
                <span class="u-hiddenVisually">{{ tab.activeLabel }}</span>
                {% else %}
                <a href="{{ tab.url }}" class="ProfileHeading-toggleLink {{ tab.openSignup ? "js-openSignupDialog js-nonNavigable" }}" data-nav="{{ tab.tab }}_toggle">
                    {{ tab.label }}
                </a>
                {% endif %}
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </div>
</div>
{% endmacro %}

{% macro empty_module(data) %}
{% import "core/macros.twig" as core %}
<div class="ProfilePage-emptyModule">
    {% set username_html %}
    {{ core.username(
        name_text: data.username,
        truncate_text: true
    ) }}
    {% endset %}
    <h3 class="ProfilePage-emptyModuleHeader">
        {{ app.i18n.formatHtml(
            "profile",
            data.headerStringId,
            username_html|trim|safeHtml
        ) }}
    </h3>
    <p class="ProfilePage-emptyModuleBody">
        {{ app.i18n.get("profile", data.bodyStringId) }}
    </p>
</div>
{% endmacro %}

{% block header %}
{% if app.page.canopy %}
{% set canopy = app.page.canopy %}
{% import "core/macros.twig" as core %}
<div class="{{ [
        'ProfileCanopy',
        'ProfileCanopy--withNav',
        'ProfileCanopy--large',
        'js-variableHeightTopBar',
    ]|join(' ') }}">
    <div class="ProfileCanopy-inner">
        <div class="ProfileCanopy-header u-bgUserColor">
            <div class="ProfileCanopy-headerBg">
                <img alt="" src="{{ canopy.banner }}">
            </div>
            <div class="AppContainer">
                <div class="ProfileCanopy-avatar">
                    <div class="ProfileAvatar">
                        <a class="ProfileAvatar-container u-block js-tooltip profile-picture"
                           href="{{ canopy.avatar.url }}"
                           data-resolved-url-large="{{ canopy.avatar.url }}"
                           data-url="{{ canopy.avatar.url }}"
                           target="_blank"
                           rel="noopener"
                           title="{{ canopy.avatar.tooltip }}"
                           >
                            <img src="{{ canopy.avatar.url }}" alt="{{ canopy.avatar.tooltip }}" class="ProfileAvatar-image">
                        </a>
                    </div>
                </div>
                <div class="ProfileCanopy-headerPromptAnchor"></div>
            </div>
        </div>
        <div class="ProfileCanopy-navBar u-boxShadow">
            <div class="AppContainer">
                <div class="Grid Grid--withGutter">
                    <div class="Grid-cell u-size1of3 u-lg-size1of4">
                        <div class="ProfileCanopy-card" role="presentation">
                            <div class="ProfileCardMini">
                                <a class="ProfileCardMini-avatar profile-picture js-tooltip"
                                   href="{{ canopy.card.avatarUrl }}"
                                   data-resolved-url-large="{{ canopy.card.avatarUrl }}"
                                   data-url="{{ canopy.card.avatarUrl }}"
                                   target="_blank"
                                   rel="noopener"
                                   title="{{ core.simple_text(canopy.card.name) }}">
                                    <img src="{{ canopy.card.avatarUrl }}" alt="{{ core.simple_text(canopy.card.displayName) }}" class="ProfileCardMini-avatarImage"></img>
                                </a>
                                <div class="ProfileCardMini-details">
                                    <div class="ProfileNameTruncated account-group">
                                        <div class="u-textTruncate u-inlineBlock ProfileNameTruncated-withBadges ProfileNameTruncated-withBadges--1">
                                            <a href="{{ canopy.card.profileUrl }}" class="fullname ProfileNameTruncated-link u-textInheritColor js-nav">
                                                {{ core.text(canopy.card.displayName) }}
                                            </a>
                                        </div>
                                        {{ core.user_badges(canopy.card.badges) }}
                                    </div>
                                    <div class="ProfileCardMini-screenname">
                                        <a href="{{ canopy.card.profileUrl }}" class="ProfileCardMini-screennameLink u-linkComplex js-nav u-dir" dir="ltr">
                                            {{ core.username(
                                                canopy.card.screenName,
                                                handle_class: [
                                                    "u-linkComplex-target",
                                                ],
                                            ) }}
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="Grid-cell u-size2of3 u-lg-size3of4">
                        <div class="ProfileCanopy-nav">
                            <div class="ProfileNav" role="navigation" data-user-id="{{ canopy.id }}">
                                <ul class="ProfileNav-list">
                                    {% for stat in canopy.stats %}
                                    <li class="ProfileNav-item ProfileNav-item--{{ stat.id }} {{ stat.active ? "is-active" }}">
                                        <a {% if not stat.active %}href="{{ stat.url }}" {% endif %}class="ProfileNav-stat ProfileNav-stat--link u-borderUserColor u-textCenter js-tooltip js-nav"
                                            title="{{ stat.tooltip }}">
                                            <span class="ProfileNav-label" aria-hidden="true">{{ stat.label }}</span>
                                            <span class="u-hiddenVisually">{{ stat.active ? stat.activeLabel : stat.label }}</span>
                                            <span class="ProfileNav-value" data-count="{{ stat.count }}" data-is-compact="false">
                                                {{ stat.value }}
                                            </span>
                                        </a>
                                    </li>
                                    {% endfor %}
                                    <li class="{{ [
                                            'ProfileNav-item',
                                            'ProfileNav-item--more',
                                            'dropdown',
                                            'is-hidden',
                                        ]|join(' ') }}">
                                        {# TODO: Used for overflow. The current implementation is to get
                                           JS loaded at all. #}
                                    </li>
                                    <li class="{{ [
                                            'ProfileNav-item',
                                            'ProfileNav-item--userActions',
                                            'u-floatRight',
                                            'u-textRight',
                                            'with-rightCaret',
                                        ]|join(' ') }}">
                                        <div class="UserActions u-textLeft">
                                            {% from "common/user_actions.twig" import render as user_actions %}
                                            {{ user_actions(canopy.userActions) }}
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}

{% block content %}
    {% if app.page.error %}
        <div class="module component">
            <div class="flex-module error-page clearfix">
                <h1>{{ app.page.error.title }}</h1>
                <p>{{ app.page.error.message }}</p>
            </div>
        </div>
    {% elseif app.page.isGridTimeline %}
        {% embed "common/two_col_page.twig" %}
            {% block col_one_content %}
                {# Embed tags have janky scoping. #}
                {% from "profile.twig" import profile_info %}
                {{ profile_info(app.page.info) }}

                {% set sidebar = app.page.sidebar %}
                <div class="Grid Grid--withGutter">
                    <div class="Grid-cell">
                        <div class="ProfileSidebar ProfileSidebar--withRightAlignment">
                            <div class="MoveableModule">
                                {% include "common/sidebar_modules.twig" %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endblock %}

            {% block col_two_content %}
                {% if app.page.content.protectedTimeline %}
                    {% from "profile.twig" import protected_timeline %}
                    {{ protected_timeline(app.page.content.protectedTimeline) }}
                {% elseif app.page.content.timeline %}
                    {% if app.page.content.heading %}
                        {# Embed tags have janky scoping. #}
                        {% from "profile.twig" import heading %}
                        {{ heading(app.page.content.heading) }}
                    {% endif %}

                    {% if app.page.content.emptyModule %}
                        {% from "profile.twig" import empty_module %}
                        {{ empty_module(app.page.content.emptyModule) }}
                    {% endif %}

                    {% from "common/grid_timeline.twig" import render_grid_timeline %}
                    {{ render_grid_timeline(app.page.content.timeline) }}
                {% endif %}
            {% endblock %}
        {% endembed %}
    {% else %}
        {% embed "common/three_col_page.twig" %}
            {% block col_one_content %}
                {# Embed tags have janky scoping. #}
                {% from "profile.twig" import profile_info %}
                {{ profile_info(app.page.info) }}
            {% endblock %}

            {% block col_two_extra_attributes %}
                {% if app.page.content.protectedTimeline %}
                    data-test-selector="ProfileTimeline"
                {% endif %}
            {% endblock %}

            {% block col_two_content %}
                {% if app.page.content.protectedTimeline %}
                    {% from "profile.twig" import protected_timeline %}
                    {{ protected_timeline(app.page.content.protectedTimeline) }}
                {% elseif app.page.content.timeline %}
                    {% if app.page.content.heading %}
                        {# Embed tags have janky scoping. #}
                        {% from "profile.twig" import heading %}
                        {{ heading(app.page.content.heading) }}
                    {% endif %}

                    {% if app.page.content.emptyModule %}
                        {% from "profile.twig" import empty_module %}
                        {{ empty_module(app.page.content.emptyModule) }}
                    {% endif %}

                    {% from "common/timeline.twig" import render_timeline %}
                    {{ render_timeline(app.page.content.timeline, {
                        timelineClasses: [
                            "ProfileTimeline",
                        ],
                    }) }}
                {% endif %}
            {% endblock %}

            {% block col_three_content %}
            {% set sidebar = app.page.sidebar %}
            <div class="Grid Grid--withGutter">
                <div class="Grid-cell">
                    <div class="ProfileSidebar ProfileSidebar--withRightAlignment">
                        <div class="MoveableModule">
                            {% include "common/sidebar_modules.twig" %}
                        </div>
                    </div>
                </div>
            </div>
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}

