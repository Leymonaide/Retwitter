{% macro simple_text(text) %}
{% if text.simpleText %}
    {{ text.simpleText }}
{% elseif text.runs %}
    {% for run in text.runs %}
        {% if run.emoji %}
            {{ run.emoji.alt }}
        {% else %}
            {{ run.text }}
        {% endif %}
    {% endfor %}
{% endif %}
{% endmacro %}

{% macro user_badges(badges) %}
    {% types {
        badges: "Retwitter\\Page\\Common\\MUserBadges",
    } %}
    <span class="UserBadges">
        {% if badges.verified %}
            <span class="Icon Icon--verified">
                <span class="u-hiddenVisually">{{ 
                    app.i18n.get('common', 'verified_tooltip') }}</span>
            </span>
        {% endif %}
        {% if badges.protected %}
            <span class="Icon Icon--protected">
                <span class="u-hiddenVisually">{{ 
                    app.i18n.get('common', 'protected_tooltip') }}</span>
            </span>
        {% endif %}
    </span>
{% endmacro %}