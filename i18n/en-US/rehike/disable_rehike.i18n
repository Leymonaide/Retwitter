# Strings related to the soft-disable feature:

# Shows in configuration settings:
disableRehike: "Disable Retwitter"
rhSettingsEnableRehike: "Enable Retwitter"

# Disabled message:
currentlyDisabledMessage: >
    You currently have Retwitter disabled. Functionality may be limited.

# Dialog box strings:
disableRehikeInfoHeader: "Are you sure?"
disableRehikeInfoDescription: >
    This will disable Retwitter until you enable it again. You can enable
    Retwitter in the account menu in the new YouTube interface, or by the URL
    parameter: ?enable_retwitter=1

# Dialog buttons:
disableRehikeInfoCancel: "Cancel"
disableRehikeInfoDisable: "Disable"