# Date/Time localization constants:
dt_ymd: "j M Y" # Year, month, and day all shown, i.e. "1 Mar 2018". As far as
                # I can tell, Twitter used the British order for these long
                # dates, and the American order for short dates.
dt_ym: "M j" # Year and month shown, i.e. "May 9"
dt_h_template: "%sh" # Up to "23h"
dt_m_template: "%sm" # Up to "59m"
dt_s_template: "%ss" # Up to "59s"

verified_tooltip: "Verified account"

more_tooltip: "More"

tweet_social_context_retweeted: "%s Retweeted"
tweet_social_context_pinned: "Pinned Tweet"
tweet_menu_copy_link: "Copy link to Tweet"
tweet_menu_embed: "Embed Tweet"
tweet_action_reply_tooltip: "Reply"
tweet_action_retweet_tooltip: "Retweet"
tweet_action_favorite_tooltip: "Like"
tweet_a11y_reply_count_singular: "%s reply"
tweet_a11y_reply_count_plural: "%s replies"
tweet_a11y_retweet_count_singular: "%s retweet"
tweet_a11y_retweet_count_plural: "%s retweets"
tweet_a11y_favorite_count_singular: "%s like"
tweet_a11y_favorite_count_plural: "%s likes"